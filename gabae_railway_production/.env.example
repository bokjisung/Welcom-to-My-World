# Local only. Railway automatically supplies PORT.
PORT=8000

# Railway public deployment: set a strong password.
GABAE_AUTH_USERNAME=gabae
GABAE_AUTH_PASSWORD=change-this-to-a-long-random-password

# Local override only. Railway Volume path is detected automatically from
# RAILWAY_VOLUME_MOUNT_PATH, so do not normally set this on Railway.
# GABAE_DATA_DIR=./data

# Dangerous escape hatches; normally leave unset.
# GABAE_ALLOW_PUBLIC=1
# GABAE_ALLOW_EPHEMERAL=1
